{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "latest",
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "BRAND_FONTS_REQUIRED": "1"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "medium"
      }
    },
    "android-play-test": {
      "distribution": "store",
      "environment": "preview",
      "channel": "android-play-test",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "node": "24.20.0",
      "env": {
        "OPENWHISPR_APP_ENV": "production",
        "BRAND_FONTS_REQUIRED": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a --max-workers=2 --no-parallel",
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "T832773L2J",
        "ascAppId": "6763804420"
      }
    }
  }
}
