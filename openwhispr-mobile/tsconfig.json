{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/ai/*": ["../shared/ai/*"],
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/ai/**/*.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.d.ts"
  ]
}
