{
  "name": "open-whispr-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "OPENWHISPR_APP_ENV=development expo run:android",
    "ios": "OPENWHISPR_APP_ENV=development expo run:ios",
    "android:production": "OPENWHISPR_APP_ENV=production expo run:android",
    "ios:production": "OPENWHISPR_APP_ENV=production expo run:ios",
    "prebuild:dev": "OPENWHISPR_APP_ENV=development expo prebuild",
    "prebuild:production": "OPENWHISPR_APP_ENV=production expo prebuild",
    "web": "expo start --web",
    "build:ios-return-map": "node scripts/build-ios-return-map.mjs",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor && expo install --check",
    "check": "npm run format && npm run lint && npm run typecheck && npm run doctor",
    "clean": "npm run format && npm run lint && npm run typecheck",
    "pretest": "npm rebuild better-sqlite3",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "patch-package",
    "eas-build-pre-install": "bundle install"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
