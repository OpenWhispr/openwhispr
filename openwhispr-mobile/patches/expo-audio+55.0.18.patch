@@ -810,8 +810,18 @@ public class AudioModule: Module {
         if !mode.shouldRouteThroughEarpiece {
           categoryOptions.insert(.defaultToSpeaker)
         }
+        // OpenWhispr: Bluetooth HFP alone (call mode) left AirPods muffled and
+        // mono for the whole recording. On iOS 26, AirPods that support
+        // high-quality recording record and play at full bandwidth instead;
+        // iOS falls back to HFP for any headset that doesn't, so its mic is
